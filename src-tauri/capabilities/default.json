{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "KGBone 메인 창 권한: 파일 대화상자, 창 제목·닫기, 이벤트",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
