<Project Sdk="Microsoft.NET.Sdk">
  <!-- 유니티 런타임 계산부(Runtime/Core)를 유니티 없이 테스트한다. 유니티와 같은 C# 9 문법 제약으로 컴파일한다. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>KGBone.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../com.kgbone.runtime/Runtime/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="../../com.kgbone.runtime/Tests/Editor/Golden*.cs;../../com.kgbone.runtime/Tests/Editor/CoreUnitTests*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
